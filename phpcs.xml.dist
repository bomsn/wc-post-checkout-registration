<?xml version="1.0"?>
<ruleset name="WC PCR">
	<description>WordPress coding standards for Post Checkout Registration for WooCommerce.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/blocks/*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="ps"/>

	<rule ref="WordPress"/>

	<config name="minimum_supported_wp_version" value="6.5"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="wc-pcr"/>
			</property>
		</properties>
	</rule>

	<!--
		The test suite is PSR-4 and discovered by PHPUnit through class names, so
		WordPress' file naming rules cannot apply. Tests also build request state
		directly, which the nonce and input sniffs are not meant to police.
	-->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.NonceVerification">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.ValidatedSanitizedInput">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
