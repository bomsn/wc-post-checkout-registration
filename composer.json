{
  "name": "bomsn/wc-post-checkout-registration",
  "description": "Post Checkout Registration for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Ali Khallad",
      "homepage": "https://alikhallad.com"
    }
  ],
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.0",
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6",
    "mockery/mockery": "^1.6"
  },
  "autoload-dev": {
    "psr-4": {
      "WC_PCR\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "format": "phpcbf --standard=WordPress",
    "lint": "phpcs --standard=WordPress",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
